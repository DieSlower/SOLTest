// Thruster plume (SDD 51 sections 4.3-4.6, 11.2): the HLSL mirror of the colour ramp, brightness, shock-diamond and
// flame envelope math of Source/SOLTest/Visuals/SOLThrusterMath.cpp, plus the vertex and pixel entry points the
// M_SOLThrusterGlow, M_SOLThrusterBurst, M_SOLThrusterTrail (Niagara flame) and M_SOLThrusterRibbon (pool flame) Custom
// nodes call. Source/SOLTest/Visuals/SOLThrusterMirror.h is the
// statement-for-statement float copy the tests compare with the double C++ (SOLTest.Thruster.MaterialMirror). A change
// to one must change the others. The entry points' argument lists are baked into the materials by
// Tools/Fx/create_thruster_assets.py: a body change needs no rebuild, a new argument does.
// The tunables arrive as material parameters whose defaults the script reads from SOL::Thruster
// (SOLThrusterMirror::MaterialVectors packs the same values), so this file holds no copy of them.
//
// Thruster section vertices (SM_SOLNpcHullCone / SM_SOLNpcHullBox / SM_SOLPlayerThrusters, mesh local units):
// UV0 = (u around the cone, s along it from the anchor) for a burst cone, the corner (-1 / +1, -1 / +1) for a glow
// quad; UV2 = anchor.xy, UV3 = (anchor.z, size m), UV4 = axis.xy, UV5 = (axis.z, burst port code). The anchor is the
// nozzle exit (glow) or the port centre (burst); the axis the exhaust direction; size the true nozzle radius r_n (glow)
// or the burst length at strength 1 (L_hull / 6). The geometry is built at full length, so the mesh
// bounds cover every state; the vertex stage re-places each vertex in true metres from the anchor (the hull instance
// may be scaled non-uniformly and inflated to its pixel floor), or collapses it onto the anchor when the section is off
// or under its pixel fade, so an idle section rasterises nothing.
// Per-ship floats (SOL::ThrusterMaterialParams): c, b, the true plume length in metres, the reverse, lateral and
// vertical burst strengths. Every pixel value is a 1080p-reference pixel (SDD 52 D8).

#pragma once

// Burst port codes (UV5.y): which signed burst float fires the port
#define SOLTH_PORT_REVERSE 0
#define SOLTH_PORT_LATERAL_POSITIVE 1
#define SOLTH_PORT_LATERAL_NEGATIVE 2
#define SOLTH_PORT_VERTICAL_POSITIVE 3
#define SOLTH_PORT_VERTICAL_NEGATIVE 4

// Upper bound of the knot-count loop (the real limit is the SHOCK_MAX_KNOTS parameter, shape.x)
#define SOLTH_KNOT_LOOP_CAP 16

// ---------------------------------------------------------------------------------------------------------------------
// Mirrored math (SOLThrusterMirror.h)
// ---------------------------------------------------------------------------------------------------------------------

// Returns a value clamped to [0, 1], NaN as 0 (SOLThrusterMirror::Unit)
float SOLTH_Unit(float value)
{
    return value >= 0.0 ? min(value, 1.0) : 0.0;
}

// Writes the ramp's rim and core colours at a colour scalar c: linear between the blue, yellow and red keys, c clamped
// to [0, 1] (NaN as 0), the yellow key at ramp.x (SOLThruster::PlumeColour)
void SOLTH_PlumeColour(float c, float4 ramp, float3 rim0, float3 rim1, float3 rim2, float3 core0, float3 core1,
    float3 core2, out float3 rim, out float3 core)
{
    const float clamped = SOLTH_Unit(c);
    const float yellowC = ramp.x;
    if (clamped <= yellowC)
    {
        const float t = clamped / yellowC;
        rim = lerp(rim0, rim1, t);
        core = lerp(core0, core1, t);
    }
    else
    {
        const float t = (clamped - yellowC) / (1.0 - yellowC);
        rim = lerp(rim1, rim2, t);
        core = lerp(core1, core2, t);
    }
}

// Returns the brightness b = min(G / gRef, 1)^exponent; 0 under minG and for a NaN or infinite G
// (SOLThruster::PlumeBrightness)
float SOLTH_PlumeBrightness(float g, float gRef, float minG, float exponent)
{
    if (!(g >= minG) || isinf(g))
    {
        return 0.0;
    }
    const float x = min(g / gRef, 1.0);
    return x > 0.0 ? pow(x, exponent) : 0.0;
}

// Returns the knot spacing shock.x r_n (1 + shock.y b), b clamped to [0, 1]; 0 for a non-positive or infinite radius
// (SOLThruster::ShockSpacingM)
float SOLTH_ShockSpacing(float nozzleRadiusM, float b, float4 shock)
{
    if (!(nozzleRadiusM > 0.0) || isinf(nozzleRadiusM))
    {
        return 0.0;
    }
    return shock.x * nozzleRadiusM * (1.0 + shock.y * SOLTH_Unit(b));
}

// Returns how many knots k S (k = 1, 2, ...) fit in the zone shock.w L_p, at most shape.x (SOLThruster::ShockKnots)
int SOLTH_ShockKnotCount(float plumeLengthM, float spacingM, float4 shock, float4 shape)
{
    if (!(plumeLengthM > 0.0) || isinf(plumeLengthM) || !(spacingM > 0.0))
    {
        return 0;
    }
    const float zoneM = shock.w * plumeLengthM;
    const int maxKnots = min((int)(shape.x + 0.5), SOLTH_KNOT_LOOP_CAP);
    int count = 0;
    for (int k = 0; k < SOLTH_KNOT_LOOP_CAP; ++k)
    {
        if (count >= maxKnots || (float)(count + 1) * spacingM > zoneM)
        {
            break;
        }
        ++count;
    }
    return count;
}

// Writes knot k's (1-based) position k S and strength decay^(k-1) (SOLThruster::ShockKnots)
void SOLTH_ShockKnot(int k, float spacingM, float4 shock, out float positionM, out float strength)
{
    positionM = (float)k * spacingM;
    strength = pow(shock.z, (float)(k - 1));
}

// Returns the shock-diamond brightness at xM metres from the nozzle and the radial fraction rFrac of the local cone
// radius: the nearest knot's rhombus (half-length shape.z S along, half-width shape.w across) times its strength; 0
// outside every knot (the knots never overlap, SHOCK_KNOT_HALF_LENGTH < 0.5)
float SOLTH_ShockIntensity(float xM, float rFrac, float spacingM, int count, float4 shock, float4 shape)
{
    if (count <= 0 || !(spacingM > 0.0))
    {
        return 0.0;
    }
    const int k = (int)clamp(floor(xM / spacingM + 0.5), 1.0, (float)count);
    float positionM;
    float strength;
    SOLTH_ShockKnot(k, spacingM, shock, positionM, strength);
    const float rhombus = abs(xM - positionM) / (shape.z * spacingM) + rFrac / shape.w;
    return strength * saturate(1.0 - rhombus);
}

// Returns the focal length in reference px from the projection's [0][0] = 1 / tan(fov / 2) (SOLThrusterMirror)
float SOLTH_FocalRefPx(float projectionScaleX, float2 viewSize, float referenceHeightPx)
{
    if (!(viewSize.x > 0.0) || !(viewSize.y > 0.0))
    {
        return 0.0;
    }
    return 0.5 * viewSize.x * projectionScaleX * referenceHeightPx / viewSize.y;
}

// Returns the linear fade clamp((px - low) / (high - low), 0, 1) (SOLThruster::LodAlpha for low < high)
float SOLTH_LodAlpha(float px, float lowPx, float highPx)
{
    return saturate((px - lowPx) / (highPx - lowPx));
}

// Returns a burst port's strength in [0, 1] from the reverse, lateral and vertical burst floats
float SOLTH_BurstPortStrength(float portCode, float3 bursts)
{
    const int code = (int)(portCode + 0.5);
    if (code == SOLTH_PORT_REVERSE)
    {
        return saturate(bursts.x);
    }
    if (code == SOLTH_PORT_LATERAL_POSITIVE)
    {
        return saturate(bursts.y);
    }
    if (code == SOLTH_PORT_LATERAL_NEGATIVE)
    {
        return saturate(-bursts.y);
    }
    if (code == SOLTH_PORT_VERTICAL_POSITIVE)
    {
        return saturate(bursts.z);
    }
    return saturate(-bursts.z);
}

// ---------------------------------------------------------------------------------------------------------------------
// Shared vertex helpers
// ---------------------------------------------------------------------------------------------------------------------

// Returns the screen-radial fraction of a cone vertex seen from the camera: 0 on the centre line, 1 on the silhouette;
// looking down the axis it falls back to the vertex's taper (the tail ring reads as the centre)
float SOLTH_ConeRadialFraction(float3 radial, float3 axis, float3 viewDir, float taper)
{
    const float3 viewPerp = viewDir - dot(viewDir, axis) * axis;
    const float perpLength = length(viewPerp);
    const float facing = perpLength > 1.0e-4 ? dot(radial, viewPerp / perpLength) : 0.0;
    const float side = sqrt(saturate(1.0 - facing * facing));
    return lerp(taper, side, saturate(perpLength * 3.0));
}

// Splits a section vertex's world offset from its anchor into the unit axis and the unit radial direction; false when
// either is degenerate
bool SOLTH_ConeFrame(float3 offsetW, float3 axisW, out float3 axis, out float3 radial)
{
    axis = float3(1.0, 0.0, 0.0);
    radial = float3(0.0, 1.0, 0.0);
    const float axisLength = length(axisW);
    if (!(axisLength > 0.0))
    {
        return false;
    }
    axis = axisW / axisLength;
    const float3 radialW = offsetW - dot(offsetW, axis) * axis;
    const float radialLength = length(radialW);
    if (!(radialLength > 0.0))
    {
        return false;
    }
    radial = radialW / radialLength;
    return true;
}

// ---------------------------------------------------------------------------------------------------------------------
// Nozzle glow (M_SOLThrusterGlow)
// ---------------------------------------------------------------------------------------------------------------------

// Places a glow quad corner: a camera-facing disc of glow.x r_n at the nozzle, drawn at least glow.y px across once
// its true diameter passes the fade (Q13, Q33); collapses when b is 0 or the glow is under its fade. interp0 = (c,
// pixel alpha, b, 0); the pixel stage reads the corner from UV0
float3 SOLTH_GlowVertex(float3 offsetW, float2 corner, float nozzleRadiusM, float c, float b, float3 cameraToVertexW,
    float3 viewRightW, float3 viewUpW, float projectionScaleX, float2 viewSize, float4 glow, float4 glowFade,
    out float4 interp0)
{
    interp0 = float4(0.0, 0.0, 0.0, 0.0);
    const float3 collapse = -offsetW;
    const float distanceCm = length(cameraToVertexW - offsetW);
    if (!(b > 0.0) || !(nozzleRadiusM > 0.0) || !(distanceCm > 0.0))
    {
        return collapse;
    }
    const float focalPx = SOLTH_FocalRefPx(projectionScaleX, viewSize, glow.w);
    const float truePx = focalPx * glow.x * nozzleRadiusM * 100.0 / distanceCm;
    const float alpha = SOLTH_LodAlpha(truePx, glowFade.x, glowFade.y);
    if (!(alpha > 0.0) || !(focalPx > 0.0))
    {
        return collapse;
    }
    const float drawnPx = max(truePx, glow.y);
    const float radiusCm = 0.5 * drawnPx * distanceCm / focalPx;
    interp0 = float4(c, alpha, b, 0.0);
    return (viewRightW * corner.x + viewUpW * corner.y) * radiusCm - offsetW;
}

// Returns the glow's additive emissive colour: a soft disc, core colour inside, rim colour outside
float3 SOLTH_GlowPixel(float4 interp0, float2 corner, float4 ramp, float3 rim0, float3 rim1, float3 rim2, float3 core0,
    float3 core1, float3 core2, float4 glow)
{
    const float disc = saturate(1.0 - length(corner));
    float3 rim;
    float3 core;
    SOLTH_PlumeColour(interp0.x, ramp, rim0, rim1, rim2, core0, core1, core2, rim, core);
    return lerp(rim, core, disc * disc) * (disc * disc * glow.z * interp0.y * interp0.z);
}

// ---------------------------------------------------------------------------------------------------------------------
// Gas bursts (M_SOLThrusterBurst)
// ---------------------------------------------------------------------------------------------------------------------

// Places a burst puff vertex (section 4.6): a short flaring cone out of its port, length L_b = size x strength in true
// metres, radius burstShape.x -> .y burst lengths; collapses when its port is not fired or the puff is under its pixel
// fade. interp0 = (t along, radial fraction, pixel alpha, strength)
float3 SOLTH_BurstVertex(float3 offsetW, float3 axisW, float2 uv, float burstLengthM, float portCode, float3 bursts,
    float3 cameraToVertexW, float projectionScaleX, float2 viewSize, float4 burstShape, float referenceHeightPx,
    out float4 interp0)
{
    interp0 = float4(0.0, 0.0, 0.0, 0.0);
    const float3 collapse = -offsetW;
    const float strength = SOLTH_BurstPortStrength(portCode, bursts);
    const float lengthM = burstLengthM * strength;
    float3 axis;
    float3 radial;
    if (!(lengthM > 0.0) || !SOLTH_ConeFrame(offsetW, axisW, axis, radial))
    {
        return collapse;
    }

    // Pixel-size fade on the puff's true length
    const float3 cameraToAnchorW = cameraToVertexW - offsetW;
    const float distanceCm = length(cameraToAnchorW);
    const float focalPx = SOLTH_FocalRefPx(projectionScaleX, viewSize, referenceHeightPx);
    const float lengthPx = distanceCm > 0.0 ? focalPx * lengthM * 100.0 / distanceCm : 1.0e30;
    const float alpha = SOLTH_LodAlpha(lengthPx, burstShape.z, burstShape.w);
    if (!(alpha > 0.0))
    {
        return collapse;
    }
    const float t = saturate(uv.y);
    const float radiusCm = lengthM * 100.0 * lerp(burstShape.x, burstShape.y, t);
    const float3 viewDir = distanceCm > 0.0 ? cameraToAnchorW / distanceCm : axis;
    interp0 = float4(t, SOLTH_ConeRadialFraction(radial, axis, viewDir, 0.0), alpha, strength);
    return axis * (t * lengthM * 100.0) + radial * radiusCm - offsetW;
}

// Returns the burst's noise coordinates: two tiles around the puff, the gas drifting outward, offset per ship
float2 SOLTH_BurstNoiseUv(float2 uv, float phase, float timeS)
{
    return float2(uv.x * 2.0 + phase, uv.y * 0.8 - frac(timeS * 1.5));
}

// Returns the burst's opacity: soft edges, fading in from the port and out at the tip, noise-dissolved and flickering
// with a per-ship phase; the gas is never hot (no ramp, no core, no diamonds)
float SOLTH_BurstOpacity(float4 interp0, float noise, float phase, float timeS, float4 burst)
{
    const float t = interp0.x;
    const float facing = sqrt(saturate(1.0 - interp0.y * interp0.y));
    const float along = saturate(1.0 - t) * saturate(t * 6.0 + 0.2);
    const float flicker = 1.0 - burst.z * (0.5 + 0.5 * sin(6.2831853 * frac(timeS * burst.y + phase)));
    return burst.x * interp0.w * interp0.z * facing * along * lerp(0.35, 1.0, saturate(noise)) * flicker;
}

// ---------------------------------------------------------------------------------------------------------------------
// One-piece flame (SDD 51 section 11.2, R10): M_SOLThrusterTrail on the NS_SOLThrusterTrails tube ribbon and
// M_SOLThrusterRibbon on the GPU strip pool share SOLTH_FlameNoiseUv and SOLTH_FlamePixel, so both renderers shade a
// flame identically. Per pixel they need: the arc fraction s / L_f (Niagara: particle colour r; pool: the point index
// over FLAME_POINTS - 1), the point alpha (colour g; pool: the texel's w), the thin-flame sharpness (colour b; pool:
// SOLTH_FlameSharpness), the cap fraction (colour a; pool: 0 on an end cap's point, 1 elsewhere, interpolated), the
// tube's around coordinate V (UV0.y: k / FLAME_TUBE_SIDES on ring vertex k in both), the flame header (c, b, L_p, r_n; Niagara: dynamic parameter 0; pool: texel 25), the
// spine direction (the vertex tangent), and the pixel-to-camera direction (no vertex normal: the radial fraction
// comes from V, which both renderers interpolate alike). flame = (FLAME_LENGTH_FACTOR, FLAME_TAIL_WIDTH_RATIO, FLAME_SHARP_LOW_PX, FLAME_SHARP_HIGH_PX). Every along-arc term is a continuous function
// of s (no branch at L_p), so the flame has no seam
// ---------------------------------------------------------------------------------------------------------------------

// Returns the smoothstep 3u^2 - 2u^3 of u clamped to [0, 1] (SOLThrusterMirror::Smoothstep)
float SOLTH_Smoothstep(float u)
{
    const float clamped = saturate(u);
    return clamped * clamped * (3.0 - 2.0 * clamped);
}

// Returns the core weight (sqrt(1 - r^2))^look.y, r clamped to [0, 1], NaN as 0 (SOLThruster::FlameCoreWeight)
float SOLTH_FlameCoreWeight(float radialFraction, float4 look)
{
    if (isnan(radialFraction))
    {
        return 0.0;
    }
    const float r = saturate(radialFraction);
    return pow(sqrt(max(1.0 - r * r, 0.0)), look.y);
}

// Returns the knot brightness at arc coordinate s and radial fraction r from the flame's header: the knot spacing and
// count, then the nearest knot's rhombus (SOLThruster::FlameKnotIntensity)
float SOLTH_FlameKnot(float arcM, float radialFraction, float plumeLengthM, float nozzleRadiusM, float b, float4 shock,
    float4 shape)
{
    const float spacingM = SOLTH_ShockSpacing(nozzleRadiusM, b, shock);
    const int count = SOLTH_ShockKnotCount(plumeLengthM, spacingM, shock, shape);
    return SOLTH_ShockIntensity(arcM, SOLTH_Unit(radialFraction), spacingM, count, shock, shape);
}

// Returns the streak depth lerp(body, tail, smoothstep((s - 0.5 L_p) / L_p)); the body depth for a non-positive L_p
// (SOLThruster::FlameStreakDepth)
float SOLTH_FlameStreakDepth(float arcM, float plumeLengthM, float bodyDepth, float tailDepth)
{
    if (!(plumeLengthM > 0.0) || isinf(plumeLengthM) || isnan(arcM))
    {
        return bodyDepth;
    }
    return lerp(bodyDepth, tailDepth, SOLTH_Smoothstep((arcM - 0.5 * plumeLengthM) / plumeLengthM));
}

// Returns the flame's width over its nozzle width at arc coordinate s, 1 - (1 - tail ratio) S(s / L_p) (the axial
// fallback of the radial fraction: looking down the spine the narrow tail reads as the core)
float SOLTH_FlameTaper(float arcM, float plumeLengthM, float4 flame)
{
    return plumeLengthM > 0.0 ? 1.0 - (1.0 - flame.y) * SOLTH_Smoothstep(arcM / plumeLengthM) : 1.0;
}

// Returns the flame's screen-radial fraction at a pixel: 0 on the spine, 1 on the silhouette, looking down the spine
// falling back to the local taper (as SOLTH_ConeRadialFraction does for a cone). Ring vertex k sits at angle a = -2 pi V
// (V = around = k / FLAME_TUBE_SIDES) at right (-0.5 cos a) + up (-0.5 sin a) x the width, right perpendicular to both
// the view and the spine and up along the view's part across the spine, so its screen offset across the spine is
// -0.5 cos a x the width in every view: the fraction is |cos a|, from the interpolated V (the same value in both
// renderers, round between the ring vertices; the front and back walls at one pixel share it, cos(-a) = cos a)
float SOLTH_FlameRadialFraction(float around, float3 tangentW, float3 toCameraW, float taper)
{
    const float tangentLength = length(tangentW);
    const float viewLength = length(toCameraW);
    if (!(tangentLength > 0.0) || !(viewLength > 0.0))
    {
        return taper;
    }
    const float3 axis = tangentW / tangentLength;
    const float3 viewDir = toCameraW / viewLength;
    const float perpLength = length(viewDir - dot(viewDir, axis) * axis);
    const float side = abs(cos(6.2831853 * around));
    return lerp(taper, side, saturate(perpLength * 3.0));
}

// Returns the point alpha of a pixel on the narrow tail seen through the neck (51e3, the idle axis dot): looking down
// the spine, a ray through the constant-width tail (s > L_p) crosses its two walls a run w |sin a| cot(theta) apart
// along s (w the tail's true width, theta the view's angle to the spine); one that passes the neck crosses only one
// tail wall, far down the tail, where the along fade 1 - s / L_f is lower than on the cone wall beside the neck, so the
// tail's mouth read as a dark dot (from either end). The wall crossed farther along s (the far half seen from the
// nozzle side, the near half from the tail side) takes the along fade at the other crossing, never before L_p (the
// neck); the alpha is unchanged on the other half, in the taper and in side views (the run is 0 at each boundary, so
// the blend is continuous and only brightens)
float SOLTH_FlameNeckAlpha(float alpha, float arcFraction, float around, float3 tangentW, float3 toCameraW, float4 header,
    float4 flame)
{
    const float arcM = arcFraction * flame.x * header.z;
    const float tangentLength = length(tangentW);
    const float viewLength = length(toCameraW);
    if (!(arcM > header.z) || !(tangentLength > 0.0) || !(viewLength > 0.0) || !(flame.x > 1.0))
    {
        return alpha;
    }
    const float3 axis = tangentW / tangentLength;
    const float3 viewDir = toCameraW / viewLength;
    // The wall half the ray crosses second when running toward the tail (the far half, sin(2 pi V) < 0) or first
    // when running toward the nozzle (the near half): the crossing farther along s
    const float towardTail = -dot(viewDir, axis);
    const float laterSide = -sin(6.2831853 * around) * sign(towardTail);
    if (!(laterSide > 0.0))
    {
        return alpha;
    }

    // The ray's run along the spine between the tail's two walls, back to its crossing nearer the nozzle (clamped at
    // the neck)
    const float sinTheta = max(length(viewDir - dot(viewDir, axis) * axis), 1.0e-4);
    const float runM = 2.0 * header.w * flame.y * laterSide * abs(towardTail) / sinTheta;
    const float entryM = max(arcM - runM, header.z);
    const float along = max(1.0 - arcFraction, 1.0e-3);
    return alpha * saturate(1.0 - entryM / (flame.x * header.z)) / along;
}

// Returns the streak noise coordinates: streak.x tiles around the tube, one tile per streak.y nozzle radii along s,
// panning back at streak.z tiles per second x b (game time)
float2 SOLTH_FlameNoiseUv(float arcFraction, float around, float4 header, float timeS, float4 streak, float4 flame)
{
    const float arcM = arcFraction * flame.x * header.z;
    const float tileLengthM = max(streak.y * header.w, 1.0e-3);
    return float2(around * streak.x, arcM / tileLengthM - frac(timeS * streak.z * header.y));
}

// Returns the flame's additive emissive colour: the ramp's rim colour outside, the core colour on the spine (tapering
// with the flame), the shock diamonds on the core in the first SHOCK_ZONE of L_p, the panning streaks deepening toward
// the tail, times the point alpha (emission b x along-arc fade x pixel fade). sharpness (SOLTH_FlameSharpness) blends the
// radial fraction to the cross-section's mean (0.5) where the flame is drawn only a few pixels wide. capFraction is the
// pixel's distance from the axis over the ring radius on an end cap (0 at the cap point, 1 on its rim; 1 on the tube):
// a cap pixel at around V sits capFraction of the way out on ring vertex V's line, so its screen offset across the
// spine is capFraction times the tube's (the radial fraction scales by it, equal to the tube's on the shared rim)
float3 SOLTH_FlamePixel(float arcFraction, float alpha, float sharpness, float capFraction, float4 header, float around,
    float3 tangentW, float3 toCameraW, float streakNoise, float4 ramp, float3 rim0, float3 rim1, float3 rim2,
    float3 core0, float3 core1, float3 core2, float4 shock, float4 shape, float4 look, float4 flame)
{
    const float arcM = arcFraction * flame.x * header.z;
    const float rawR = saturate(saturate(capFraction) * SOLTH_FlameRadialFraction(around, tangentW, toCameraW,
        SOLTH_FlameTaper(arcM, header.z, flame)));
    const float r = lerp(0.5, rawR, saturate(sharpness));
    float3 rim;
    float3 core;
    SOLTH_PlumeColour(header.x, ramp, rim0, rim1, rim2, core0, core1, core2, rim, core);
    const float facing = sqrt(saturate(1.0 - r * r));
    const float coreWeight = SOLTH_FlameCoreWeight(r, look);
    const float knot = SOLTH_FlameKnot(arcM, r, header.z, header.w, header.y, shock, shape);
    const float depth = SOLTH_FlameStreakDepth(arcM, header.z, look.w, shape.y);
    const float streak = lerp(1.0 - depth, 1.0, saturate(streakNoise));
    const float3 colour = lerp(rim, core, coreWeight) * (0.3 + 0.7 * facing) + core * (knot * look.z);
    const float neckAlpha = SOLTH_FlameNeckAlpha(alpha, arcFraction, around, tangentW, toCameraW, header, flame);
    return colour * (look.x * saturate(neckAlpha) * streak);
}

// ---------------------------------------------------------------------------------------------------------------------
// Flame strip pool (M_SOLThrusterRibbon, SDD 51 R7, R10): draws the NPC flames Niagara does not, and must look the
// same as NS_SOLThrusterTrails (straight segments between the spine points, a FLAME_TUBE_SIDES-sided tube oriented
// like Niagara's Screen-facing Tube shape, the same width, floor and pixel)
// ---------------------------------------------------------------------------------------------------------------------
// Block mesh (built at runtime by the pool component): RIBBON_TRAILS_PER_BLOCK flames x FLAME_DRAWN_POINTS rings x
// (FLAME_TUBE_SIDES + 1) vertices, UV0 = (drawn point index, around V = k / sides), UV1.x = the flame's index in the
// block (small integers and sixteenths, exact in half precision); per-instance custom data 0 = the block's first flame.
// The component sits at the render-space origin with identity instances, so its local position is render-space cm.
// Texture (PF_A32B32G32R32F, nearest): one block per row; flame t's RIBBON_TEXELS_PER_TRAIL texels start at column
// (t % trailsPerBlock) x texelsPerTrail of row t / trailsPerBlock. The per-flame texels (SOLThruster::PackRibbonTexels):
// drawn points 0..26 = (x, y, z metres from the frame anchor in render-space axes, alpha) (0 and 26 the end caps,
// SOLThruster::AddFlameCaps), texel 27 = the header (c, b, L_p, r_n), texels 28..33 = the unfloored full widths of
// drawn points 2..25, four per texel (drawn point 1, the nozzle, is 2 r_n; a cap ring has radius 0).
// frame = (anchor x, y, z in render-space cm, live flame count); ribbon = (RIBBON_MIN_WIDTH_PX,
// RIBBON_TEXELS_PER_TRAIL, RIBBON_TRAILS_PER_BLOCK, FLAME_DRAWN_POINTS).
// Returns the Load coordinate of texel k of trail t
int3 SOLTH_RibbonTexel(float trail, int texel, float4 ribbon)
{
    const int trailsPerBlock = max((int)(ribbon.z + 0.5), 1);
    const int texelsPerTrail = (int)(ribbon.y + 0.5);
    const int t = (int)(trail + 0.5);
    return int3((t % trailsPerBlock) * texelsPerTrail + texel, t / trailsPerBlock, 0);
}

// Returns drawn point p's (1 .. 25, a cap passes its end point) unfloored full width in metres: 2 r_n (the header's w)
// at the nozzle, else its packed component
float SOLTH_RibbonPointWidth(int p, float4 header, float4 widths)
{
    if (p <= 1)
    {
        return 2.0 * header.w;
    }
    const int c = (p - 2) % 4;
    return dot(widths, float4(c == 0, c == 1, c == 2, c == 3));
}

// Returns a unit vector, or zero for a vector shorter than minLength (Niagara's ribbon segment rule)
float3 SOLTH_RibbonUnit(float3 v, float minLength)
{
    const float len = length(v);
    return len > minLength ? v / len : float3(0.0, 0.0, 0.0);
}

// Returns the ribbon direction at point p from its neighbours p - 2 .. p + 2 (metres), as the Niagara CPU ribbon
// builds it with tessellation off: the normalised sum of the unit segments around a point; at the first and last
// point the end segment reflected about its neighbour's direction (curvature continuous at the ends). A point within
// 1 cm of the previous one (which Niagara drops) follows the next segment; the padding past the live count gets none
float3 SOLTH_RibbonTangent(float3 p2, float3 p1, float3 p0, float3 n1, float3 n2, bool bFirst, bool bLastSlot)
{
    const float minM = 0.01;
    const float3 back = SOLTH_RibbonUnit(p0 - p1, minM);
    const float3 ahead = bLastSlot ? float3(0.0, 0.0, 0.0) : SOLTH_RibbonUnit(n1 - p0, minM);
    if (bFirst)
    {
        // First point: the first segment reflected about point 1's direction
        const float3 aheadNext = bLastSlot ? float3(0.0, 0.0, 0.0) : SOLTH_RibbonUnit(n2 - n1, minM);
        if (!(dot(ahead, ahead) > 0.0))
        {
            // Point 1 on the head (Niagara drops it): follow the segment after it
            return aheadNext;
        }
        const float3 next = SOLTH_RibbonUnit(ahead + aheadNext, 1.0e-6);
        return dot(aheadNext, aheadNext) > 0.0 ? 2.0 * dot(ahead, next) * ahead - next : ahead;
    }
    if (!(dot(back, back) > 0.0))
    {
        // On the previous point (Niagara drops it): follow the next segment, none for the padding
        return ahead;
    }
    if (dot(ahead, ahead) > 0.0)
    {
        return SOLTH_RibbonUnit(back + ahead, 1.0e-6);
    }

    // Last live point: the last segment reflected about the previous point's direction (none on a 2-point ribbon)
    const float3 backPrev = SOLTH_RibbonUnit(p1 - p2, minM);
    if (!(dot(backPrev, backPrev) > 0.0))
    {
        return back;
    }
    const float3 prev = SOLTH_RibbonUnit(backPrev + back, 1.0e-6);
    return 2.0 * dot(back, prev) * back - prev;
}

// Returns the thin-flame shading weight (true / drawn width) x clamp((drawn px - flame.z) / (flame.w - flame.z), 0, 1):
// 1 where the flame is drawn at its true width and several pixels wide, falling to 0 at the 1 px floor
// (SOL::Thruster::FLAME_SHARP_*; the Niagara feeder computes the same on the CPU)
float SOLTH_FlameSharpness(float trueCm, float drawnCm, float pixelCm, float4 flame)
{
    if (!(drawnCm > 0.0) || !(pixelCm > 0.0))
    {
        return 1.0;
    }
    const float drawnPx = drawnCm / pixelCm;
    return saturate(trueCm / drawnCm) * saturate((drawnPx - flame.z) / max(flame.w - flame.z, 1.0e-3));
}

// Places a tube vertex (R10-Q2): the spine point at frame.xyz + 100 x its metres, offset on the ring of Niagara's
// Screen-facing Tube shape (slice vertex k at angle -2 pi V: (-0.5 cos, -0.5 sin) on (right, up) with right =
// cross(camera - point, direction), up = cross(direction, right)) times the width floored at ribbon.x device pixels at
// the point's distance (2 d / (ViewToClip[1][1] x view height) per pixel, SOLThruster::RibbonDrawnWidthM), times
// ringScale (0 on an end cap's point, which keeps its end point's width for the sharpness, as the Niagara feeder does).
// Outputs: interp0 = (arc fraction, alpha, around V, sharpness) and the spine direction (Niagara's vertex tangent).
// renderToTranslated is the translated-world position of the render-space origin; viewHeightPx is the device height,
// ViewSizeAndInvSize.y x ResolutionFractionAndInv.y
float3 SOLTH_FlameVertex(float4 here, float3 direction, float widthM, float ringScale, float around, float arcFraction,
    float3 localPos, float3 renderToTranslated, float3 cameraTranslated, float projectionScaleY, float viewHeightPx,
    float4 frame, float4 ribbon, float4 flame, out float4 interp0, out float3 tangentW)
{
    const float3 hereCm = frame.xyz + here.xyz * 100.0;
    const float3 toCamera = cameraTranslated - (renderToTranslated + hereCm);
    const float distanceCm = length(toCamera);
    const float3 facing = distanceCm > 0.0 ? toCamera / distanceCm : float3(0.0, 0.0, 0.0);
    const float3 right = SOLTH_RibbonUnit(cross(facing, direction), 1.0e-6);
    const float3 up = cross(direction, right);
    const float pixelCm = projectionScaleY > 0.0 && viewHeightPx > 0.0
        ? 2.0 * distanceCm / (projectionScaleY * viewHeightPx) : 0.0;
    const float drawnCm = max(max(widthM, 0.0) * 100.0, ribbon.x * pixelCm);
    float sinAngle;
    float cosAngle;
    sincos(-6.2831853 * around, sinAngle, cosAngle);
    tangentW = direction;
    interp0 = float4(arcFraction, here.w, around, SOLTH_FlameSharpness(max(widthM, 0.0) * 100.0, drawnCm, pixelCm,
        flame));
    return hereCm + (right * (-0.5 * cosAngle) + up * (-0.5 * sinAngle)) * (drawnCm * ringScale) - localPos;
}