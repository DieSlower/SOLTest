// NPC lane guidance tunnel (SDD 49 sections 4.5-4.7, far field SDD 52): the HLSL mirror of
// Source/SOLTest/Npc/SOLNpcTunnelMath.cpp (the flat ring lattice x = w S0, the ring / gap / end-ring slots, the end,
// near, cap, pixel-size and gap fades, the focal length in 1080p-reference px), plus the vertex and pixel entry points
// the M_SOLNpcTunnel Custom nodes call. Source/SOLTest/Npc/SOLNpcTunnelMirror.h is the statement-for-statement float
// copy the tests compare with the double C++. A change to one must change the others. The entry points' argument
// lists are baked into M_SOLNpcTunnel.uasset by Tools/Npc/create_npc_assets.py: a body change needs no rebuild, a new
// argument does (SDD 52 D16: the user-approved rebuild added layout4).
// Per-lane data comes from the tunnel texture NpcTunnelTex (column = lane, SOLNpcTunnel::WriteTunnelTexels): row 0 =
// (foot point relative to the viewpoint, ecliptic m; tunnel radius Rt), row 1 = (axis; label strength, read by the
// lane and point materials, not here), row 2 = (up; ring phase), row 3 = (end arc A, end arc B relative to the foot
// arc; draw fade; unused 0); right = axis x up. The tunables arrive as material parameters set once from
// SOLConstants.h (SOLNpcTunnel::TunnelMaterialVectors), so this file has no copy of them.
// Placement, occlusion and the glow profile are the orbit lines' and lanes' (SOLOrbitLine.ush, SOLNpcLane.ush).
//
// Slot mesh (vertices at zero, one ISM instance per drawable lane, custom data 0 = the lane): UV0 = (kind, slot) with
// kind 0 ring, 1 end ring (slot = end 0 / 1), 2 dot, 3 chevron (slot = gap slot); rings: UV1 = (sample, side -1 / +1),
// UV2 = (segments, 0); dots and chevrons: UV1 = quad corner (-1 / +1, -1 / +1), UV2 = (row or wall 0 out / 1 in, dot
// or chevron index).
//
// Parameter vectors: frame = (viewpoint render location cm, max render distance cm); style0 = (ring width px, end ring
// width px, dot size px, reference height px); style1 = (emissive, chevron alpha, glow pad px, dot radius scale);
// shape = (chevron radius scale, chevron half width radii, chevron half length radii, radius fade gone px); style2 =
// (chevron notch fraction, detail near fade start radii, detail near fade full radii, dot world diameter radii);
// style3 = (ring gap fade gone px, chevron far fade start radii, chevron far fade end radii, chevrons per gap);
// layout0 = (base spacing radii, ring gap fade full px, ring slots per side, gap slots per side); layout1 = (end fade
// spacings, radius fade solid px, radius fade knee px, radius fade knee alpha); layout2 = (near fade start, near fade
// full, radial full, radial none; tunnel radii); layout3 = (detail gap fade gone px, detail gap fade full px, dots per
// gap, dot rows); layout4 = (end ring minimum drawn radius px, ribbon inner max fraction of the ring radius,
// QualityPreset threshold scale (0 reads as 1; SDD 53 7.1, part 53d), 0); glow0 / glow1 as SOLNpcLane.ush. Every pixel
// value is a 1080p-reference pixel (SDD 52 D8); every pixel fade threshold (radius, ring-gap and detail-gap fades) is
// multiplied by the quality scale by reading the focal over it (SOLNT_FadeFocalRefPx), sizes and widths are not

#pragma once

#include "/Project/SOLTest/Private/SOLNpcLane.ush"

#define SOLNT_KIND_RING 0
#define SOLNT_KIND_END_RING 1
#define SOLNT_KIND_DOT 2
#define SOLNT_KIND_CHEVRON 3
#define SOLNT_TWO_PI 6.28318530718
#define SOLNT_HUGE_PX 1.0e30

// Element kinds the slot alpha distinguishes (TunnelPlaceElement's ETunnelElement)
#define SOLNT_ELEMENT_RING 0
#define SOLNT_ELEMENT_DOT 1
#define SOLNT_ELEMENT_CHEVRON 2

// Colour codes the vertex stage hands the pixel stage
#define SOLNT_CODE_RING 0.0
#define SOLNT_CODE_END_RING 1.0
#define SOLNT_CODE_DOT_OUT 2.0
#define SOLNT_CODE_DOT_IN 3.0
#define SOLNT_CODE_CHEVRON_OUT 4.0
#define SOLNT_CODE_CHEVRON_IN 5.0

// Descending smoothstep: 1 at and below low, 0 at and above high
float SOLNT_SmoothFall(float value, float low, float high)
{
    const float t = saturate((value - low) / (high - low));
    return 1.0 - t * t * (3.0 - 2.0 * t);
}

// TunnelLogRamp: 0 at and below gone (and NaN), 1 at and above full, ln(v / gone) / ln(full / gone) between
float SOLNT_LogRamp(float value, float gone, float full)
{
    if (!(value > gone))
    {
        return 0.0;
    }
    if (value >= full)
    {
        return 1.0;
    }
    return saturate(log(value / gone) / log(full / gone));
}

// FocalLengthRefPx from the view: (W / 2) / tan(fov / 2) x reference height / H, with ViewToClip[0][0] =
// 1 / tan(fov / 2); 0 without a view size
float SOLNT_FocalRefPx(float projectionScaleX, float2 viewSize, float referenceHeightPx)
{
    if (!(viewSize.x > 0.0) || !(viewSize.y > 0.0))
    {
        return 0.0;
    }
    return 0.5 * viewSize.x * projectionScaleX * referenceHeightPx / viewSize.y;
}

// FadeFocalRefPx: the focal the pixel fades read, the focal over the QualityPreset scale (a scale below 1 reads as 1)
float SOLNT_FadeFocalRefPx(float focalRefPx, float qualityScale)
{
    return focalRefPx / max(qualityScale, 1.0);
}

// TunnelSizePx: a world size of sizeRadii x Rt on screen in reference px, f x size / d (huge for d <= 0)
float SOLNT_SizePx(float d, float rt, float focalRefPx, float sizeRadii)
{
    if (!(d > 0.0))
    {
        return SOLNT_HUGE_PX;
    }
    return focalRefPx * sizeRadii * rt / d;
}

// RingRadiusFade: 1 from the solid px, the knee alpha at the knee px, 0 at and below the gone px, log-linear between
float SOLNT_RadiusFade(float radiusPx, float4 shape, float4 layout1)
{
    const float solidPx = layout1.y;
    const float kneePx = layout1.z;
    const float kneeAlpha = layout1.w;
    const float gonePx = shape.w;
    if (radiusPx >= solidPx)
    {
        return 1.0;
    }
    if (radiusPx >= kneePx)
    {
        return kneeAlpha + (1.0 - kneeAlpha) * log(radiusPx / kneePx) / log(solidPx / kneePx);
    }
    if (radiusPx > gonePx)
    {
        return kneeAlpha * log(radiusPx / gonePx) / log(kneePx / gonePx);
    }
    return 0.0;
}

// RingGapPx: the on-screen gap in reference px to the ring one spacing farther from the camera, f x max(the angle
// between the rays to their centres, the difference of their angular radii); huge at the camera
float SOLNT_RingGapPx(float x, float h, float rt, float focalRefPx, float s0)
{
    const float ax = abs(x);
    const float ah = abs(h);
    const float d = sqrt(ax * ax + ah * ah);
    if (!(d > 0.0))
    {
        return SOLNT_HUGE_PX;
    }
    const float nextX = ax + s0;
    const float nextD = sqrt(nextX * nextX + ah * ah);
    const float rays = atan2(nextX, ah) - atan2(ax, ah);
    const float radii = rt / d - rt / nextD;
    return focalRefPx * max(rays, radii);
}

// TunnelEndFade: clamp(dEnd / (end fade spacings x S0), 0, 1)
float SOLNT_EndFade(float distanceToEnd, float s0, float4 layout1)
{
    return saturate(distanceToEnd / (layout1.x * s0));
}

// TunnelNearFadeAt: 1 - radial weight(h) x (1 - near(x)), the near fade a smoothstep on |x|
float SOLNT_NearFadeAt(float x, float h, float rt, float4 layout2)
{
    const float t = saturate((abs(x) - layout2.x * rt) / ((layout2.y - layout2.x) * rt));
    const float nearFade = t * t * (3.0 - 2.0 * t);
    const float weight = SOLNT_SmoothFall(abs(h), layout2.z * rt, layout2.w * rt);
    return 1.0 - weight * (1.0 - nearFade);
}

// TunnelDetailNearFade: 0 inside the start, 1 from the full radius (the element's own distance), smoothstep between
float SOLNT_DetailNearFade(float elementDistance, float rt, float4 style2)
{
    const float t = saturate((elementDistance - style2.y * rt) / ((style2.z - style2.y) * rt));
    return t * t * (3.0 - 2.0 * t);
}

// TunnelChevronFarFade: 1 inside the start, 0 from the end, a falling smoothstep between (D22, like the mock-up)
float SOLNT_ChevronFarFade(float d, float rt, float4 style3)
{
    const float t = saturate((d - style3.y * rt) / ((style3.z - style3.y) * rt));
    return 1.0 - t * t * (3.0 - 2.0 * t);
}

// ChevronDartDistance: signed distance from the filled dart, tip (0, 1), wings (+-1, -1), notch (0, -notch)
float SOLNT_ChevronDartDistance(float2 corner, float notch)
{
    const float ax = abs(corner.x);
    const float front = (2.0 * ax + corner.y - 1.0) * 0.44721359550;
    const float rearSlope = 1.0 - notch;
    const float rear = (-rearSlope * ax - corner.y - notch) * rsqrt(rearSlope * rearSlope + 1.0);
    return max(front, rear);
}

// TunnelPlaceElement: the alpha of a ring, dot or chevron at warp coordinate w on the flat lattice (x = w S0): cap,
// end and near fades for every element; a ring its radius and ring-gap fades, a dot its ring's radius fade and the
// detail gap gate, a chevron its length fade, the gate and the chevron far fade (SDD 52 section 4.4, D12); 0 outside
// the end rings. outX = its axial offset from the foot point
float SOLNT_ElementAlpha(float w, float capFade, int element, float h, float rt, float focalRefPx, float2 endArcs,
    float4 shape, float4 style3, float4 layout0, float4 layout1, float4 layout2, float4 layout3, out float outX)
{
    const float s0 = layout0.x * rt;
    const float x = w * s0;
    outX = x;
    if (!(x > endArcs.x && x < endArcs.y) || !(capFade > 0.0))
    {
        return 0.0;
    }

    // Cap, end and near fades shared by every element
    const float d = sqrt(x * x + h * h);
    const float distanceToEnd = min(x - endArcs.x, endArcs.y - x);
    float alpha = capFade * SOLNT_EndFade(distanceToEnd, s0, layout1) * SOLNT_NearFadeAt(x, h, rt, layout2);
    if (!(alpha > 0.0))
    {
        return 0.0;
    }

    // The element's own size and gap fades
    const float gapPx = SOLNT_RingGapPx(x, h, rt, focalRefPx, s0);
    if (element == SOLNT_ELEMENT_RING)
    {
        alpha *= SOLNT_RadiusFade(SOLNT_SizePx(d, rt, focalRefPx, 1.0), shape, layout1)
            * SOLNT_LogRamp(gapPx, style3.x, layout0.y);
    }
    else if (element == SOLNT_ELEMENT_DOT)
    {
        alpha *= SOLNT_RadiusFade(SOLNT_SizePx(d, rt, focalRefPx, 1.0), shape, layout1)
            * SOLNT_LogRamp(gapPx, layout3.x, layout3.y);
    }
    else
    {
        alpha *= SOLNT_RadiusFade(SOLNT_SizePx(d, rt, focalRefPx, 2.0 * shape.z), shape, layout1)
            * SOLNT_LogRamp(gapPx, layout3.x, layout3.y) * SOLNT_ChevronFarFade(d, rt, style3);
    }
    return alpha;
}

// EndRingAlpha: TunnelNearFadeAt x RingRadiusFade(RingRadiusPx) at the end ring's arc (the pixel curve, D14);
// outRadiusPx = its radius on screen in reference px
float SOLNT_EndRingAlpha(float x, float h, float rt, float focalRefPx, float4 shape, float4 layout1, float4 layout2,
    out float outRadiusPx)
{
    const float d = sqrt(x * x + h * h);
    outRadiusPx = SOLNT_SizePx(d, rt, focalRefPx, 1.0);
    return SOLNT_NearFadeAt(x, h, rt, layout2) * SOLNT_RadiusFade(outRadiusPx, shape, layout1);
}

// EndRingDrawnRadiusPx: max(r, the floor); the floor for NaN
float SOLNT_EndRingDrawnRadiusPx(float radiusPx, float floorPx)
{
    return radiusPx > floorPx ? radiusPx : floorPx;
}

// RingRibbonInnerExtentPx: min(half extent, fraction x ring radius), 0 for a NaN or non-positive input; the ribbon's
// inner half stops short of the ring's centre, so a ring smaller than its glow never folds into bowties
float SOLNT_RingRibbonInnerExtentPx(float halfExtentPx, float ringRadiusPx, float fraction)
{
    if (!(halfExtentPx > 0.0) || !(ringRadiusPx > 0.0))
    {
        return 0.0;
    }
    return min(halfExtentPx, fraction * ringRadiusPx);
}

// Ring slot k's warp coordinate (ahead: k + 1 - phase; behind: -((k - PER_SIDE) + phase))
float SOLNT_RingSlotW(float slot, float phase, float perSide)
{
    return slot < perSide ? slot + 1.0 - phase : -((slot - perSide) + phase);
}

// Gap slot k's ring warp coordinate (ahead: k - phase; behind: -(k - PER_SIDE + 1) - phase)
float SOLNT_GapSlotW(float slot, float phase, float perSide)
{
    return slot < perSide ? slot - phase : -(slot - perSide + 1.0) - phase;
}

// Places a viewpoint-relative point (ecliptic m) in render space (cm, Unreal axes), far-depth compressed
float3 SOLNT_Place(float3 relM, float4 frame)
{
    return frame.xyz + SOLOL_EclipticToUnreal(SOLOL_PlaceLinePointCm(relM, frame.w));
}

// World units per pixel at a render point's view depth
float SOLNT_WorldPerPixel(float3 placedUnreal, float3 cameraUnreal, float3 forward, float projectionScaleX,
    float viewWidthPx)
{
    const float depth = max(abs(dot(placedUnreal - cameraUnreal, forward)), 1.0);
    return 2.0 * depth / max(projectionScaleX * viewWidthPx, 1.0);
}

// Vertex stage: returns the slot vertex's render position (cm, Unreal axes; the mesh vertices sit at zero so this is
// the world position offset), or the origin when the element is hidden (nothing is rasterised).
// outInterp0 = (signed px across a ring, or quad corner x; quad corner y; alpha; colour code),
// outInterp1 = (the element point relative to the viewpoint, ecliptic m; a dot's diameter px, else 0) for the pixel
// stage's occlusion and dot profile
float3 SOLNT_Vertex(float3 uv0, float2 uv1, float2 uv2, float4 t0, float4 t1, float4 t2, float4 t3,
    float3 cameraUnreal, float4 frame, float4 style0, float4 style1, float4 shape, float4 style2, float4 style3,
    float4 layout0, float4 layout1, float4 layout2, float4 layout3, float4 layout4, float4 glow0, float3 right,
    float3 up, float3 forward, float projectionScaleX, float2 viewSize, out float4 outInterp0, out float4 outInterp1)
{
    outInterp0 = float4(0.0, 0.0, 0.0, 0.0);
    outInterp1 = float4(0.0, 0.0, 0.0, 0.0);
    const float rt = t0.w;
    const float fade = t3.z;
    const float focalRefPx = SOLNT_FocalRefPx(projectionScaleX, viewSize, style0.w);
    if (!(fade > 0.0) || !(rt > 0.0) || !(focalRefPx > 0.0))
    {
        return float3(0.0, 0.0, 0.0);
    }

    // The fades read the focal over the QualityPreset scale (every pixel threshold x the scale, as the CPU's class
    // thresholds, so a class switch stays invisible at every preset); sizes keep the live focal
    const float fadeFocalPx = SOLNT_FadeFocalRefPx(focalRefPx, layout4.z);

    // The lane's tunnel frame: foot point, basis, phase, end arcs, the camera's distance from the axis
    const float3 foot = t0.xyz;
    const float3 axis = t1.xyz;
    const float3 tubeUp = t2.xyz;
    const float3 tubeRight = cross(axis, tubeUp);
    const float phase = t2.w;
    const float2 endArcs = t3.xy;
    const float h = length(foot);
    const int kind = (int)(uv0.x + 0.5);
    const float slot = floor(uv0.y + 0.5);
    const float scale = SOLNL_HeightScale(viewSize.y, style0.w);

    if (kind == SOLNT_KIND_RING || kind == SOLNT_KIND_END_RING)
    {
        // The ring's axial offset, alpha and drawn radius: a ring slot on the lattice; an end ring at its arc on the
        // pixel curve, drawn at least the floor's radius (D14)
        float x = 0.0;
        float alpha = 0.0;
        float drawnRt = rt;
        float widthPx = style0.x * scale;
        float code = SOLNT_CODE_RING;
        if (kind == SOLNT_KIND_RING)
        {
            const float w = SOLNT_RingSlotW(slot, phase, layout0.z);
            alpha = SOLNT_ElementAlpha(w, saturate(layout0.z - abs(w)), SOLNT_ELEMENT_RING, h, rt, fadeFocalPx,
                endArcs, shape, style3, layout0, layout1, layout2, layout3, x);
        }
        else if (endArcs.x < endArcs.y)
        {
            x = slot < 0.5 ? endArcs.x : endArcs.y;
            float fadeRadiusPx;
            alpha = SOLNT_EndRingAlpha(x, h, rt, fadeFocalPx, shape, layout1, layout2, fadeRadiusPx);
            const float radiusPx = SOLNT_SizePx(sqrt(x * x + h * h), rt, focalRefPx, 1.0);
            drawnRt = radiusPx > 0.0 && radiusPx < SOLNT_HUGE_PX
                ? rt * (SOLNT_EndRingDrawnRadiusPx(radiusPx, layout4.x) / radiusPx) : rt;
            widthPx = style0.y * scale;
            code = SOLNT_CODE_END_RING;
        }
        if (!(alpha > 0.0))
        {
            return float3(0.0, 0.0, 0.0);
        }

        // Sample k of the circle clockwise from 12 o'clock, its tangent, then the ribbon across the view ray
        float s;
        float c;
        sincos(SOLNT_TWO_PI * uv1.x / max(uv2.x, 1.0), s, c);
        const float3 centreM = foot + axis * x;
        const float3 pointM = centreM + (tubeUp * c + tubeRight * s) * drawnRt;
        const float3 placed = SOLNT_Place(pointM, frame);
        const float3 side = SOLOL_RibbonSideDirection(placed - cameraUnreal,
            SOLOL_EclipticToUnreal(tubeRight * c - tubeUp * s));
        const float worldPerPx = SOLNT_WorldPerPixel(placed, cameraUnreal, forward, projectionScaleX, viewSize.x);
        const float halfExtentPx = SOLNL_RibbonHalfExtentPx(widthPx, scale, style1.z, glow0.x);

        // The inward vertex (its side toward the placed centre) reaches at most a fraction of the ring's radius on
        // screen, so a ring smaller than its ribbon keeps its quads unfolded (no overlapping bowties, no glare); the
        // outward vertex and every vertex of a larger ring keep the full half extent
        const float3 towardCentre = SOLNT_Place(centreM, frame) - placed;
        const bool bInward = dot(side * uv1.y, towardCentre) > 0.0;
        const float signedPx = bInward
            ? uv1.y * SOLNT_RingRibbonInnerExtentPx(halfExtentPx, length(towardCentre) / worldPerPx, layout4.y)
            : uv1.y * halfExtentPx;
        outInterp0 = float4(signedPx, 0.0, alpha * fade, code);
        outInterp1 = float4(pointM, 0.0);
        return placed + side * (signedPx * worldPerPx);
    }

    // Dots and chevrons: the gap slot's element at its warp coordinate (the detail-cap, size and gap fades); element
    // i sits at i / count of the gap (on the ring and halfway, guide thinning)
    const bool bDot = kind == SOLNT_KIND_DOT;
    const float offset = uv2.y / max(bDot ? layout3.z : style3.w, 1.0);
    const float w = SOLNT_GapSlotW(slot, phase, layout0.w) + offset;
    float x;
    float alpha = SOLNT_ElementAlpha(w, saturate(layout0.w - 1.0 - abs(w)),
        bDot ? SOLNT_ELEMENT_DOT : SOLNT_ELEMENT_CHEVRON, h, rt, fadeFocalPx, endArcs, shape, style3, layout0, layout1,
        layout2, layout3, x);
    if (!(alpha > 0.0))
    {
        return float3(0.0, 0.0, 0.0);
    }
    if (bDot)
    {
        // A camera-facing round quad on the dot row (outside the rings): DotDrawnSizePx by its own distance (world
        // sized near, never below the floor), faded near the camera (fill cost at the wall)
        const float clockRad = SOLNT_TWO_PI * (uv2.x + 0.5) / max(layout3.w, 1.0);
        float s;
        float c;
        sincos(clockRad, s, c);
        const float3 pointM = foot + axis * x + (tubeUp * c + tubeRight * s) * (style1.w * rt);
        const float3 placed = SOLNT_Place(pointM, frame);
        const float dotDistanceM = length(pointM);
        const float dotPx = max(SOLNT_SizePx(dotDistanceM, rt, focalRefPx, style2.w), style0.z) * scale;
        const float halfPx = SOLNL_RibbonHalfExtentPx(dotPx, scale, style1.z, glow0.x);
        alpha *= SOLNT_DetailNearFade(dotDistanceM, rt, style2);
        if (!(alpha > 0.0))
        {
            return float3(0.0, 0.0, 0.0);
        }
        const bool bOutbound = uv2.x < 0.5 * layout3.w;
        outInterp0 = float4(uv1.x, uv1.y, alpha * fade, bOutbound ? SOLNT_CODE_DOT_OUT : SOLNT_CODE_DOT_IN);
        outInterp1 = float4(pointM, dotPx);
        return placed + (right * uv1.x + up * uv1.y) * (halfPx * SOLNT_WorldPerPixel(placed, cameraUnreal, forward,
            projectionScaleX, viewSize.x));
    }

    // A chevron: flat on the wall at 3 o'clock (outbound, pointing toward B) or 9 o'clock (inbound, toward A),
    // world-sized so it foreshortens; corner y runs along its pointing direction, x around the tube
    const bool bOutboundWall = uv2.x < 0.5;
    const float3 wall = bOutboundWall ? tubeRight : -tubeRight;
    const float3 around = bOutboundWall ? -tubeUp : tubeUp;
    const float3 along = bOutboundWall ? axis : -axis;
    const float3 centreM = foot + axis * x + wall * (shape.x * rt);
    alpha *= SOLNT_DetailNearFade(length(centreM), rt, style2);
    if (!(alpha > 0.0))
    {
        return float3(0.0, 0.0, 0.0);
    }
    const float3 pointM = centreM + around * (uv1.x * shape.y * rt) + along * (uv1.y * shape.z * rt);
    outInterp0 = float4(uv1.x, uv1.y, alpha * fade * style1.y,
        bOutboundWall ? SOLNT_CODE_CHEVRON_OUT : SOLNT_CODE_CHEVRON_IN);
    outInterp1 = float4(pointM, 0.0);
    return SOLNT_Place(pointM, frame);
}

// The chevron's coverage in its quad (corner coordinates in [-1, 1], pointing toward +y): the mock-up's filled,
// notched dart (SOLNT_ChevronDartDistance), anti-aliased over a pixel
float SOLNT_ChevronCoverage(float2 corner, float notch)
{
    const float distance = SOLNT_ChevronDartDistance(corner, notch);
    const float feather = max(fwidth(distance), 1e-4);
    return saturate(0.5 - distance / feather);
}

// Pixel stage: returns the additive emissive colour = colour x alpha x emissive x profile, 0 where a true-scale
// occluder sphere or near scene depth hides the element's point. orbitStyle2 = the orbit lines' (highlight min alpha,
// feather px, depth bias, scene-depth trust limit cm); occluders[i] = (viewpoint-relative centre m; radius m)
float3 SOLNT_Pixel(float4 interp0, float4 interp1, float3 cameraUnreal, float4 frame, float4 style0, float4 style1,
    float4 style2, float4 glow0, float4 glow1, float glowScale, float3 ringColor, float3 dotOutColor, float3 dotInColor,
    float3 chevronOutColor, float3 chevronInColor, float4 orbitStyle2, float viewportHeightPx, float pixelDepthCm,
    float sceneDepthCm, float4 occluders[SOLOL_MAX_OCCLUDERS])
{
    const float code = interp0.w;
    const float alpha = interp0.z;
    const float chevronCoverage = SOLNT_ChevronCoverage(interp0.xy, style2.x);
    if (!(alpha > 0.0))
    {
        return float3(0.0, 0.0, 0.0);
    }

    // The shape: the glow profile across a ring or round a dot, the arrowhead of a chevron
    const float scale = SOLNL_HeightScale(viewportHeightPx, style0.w);
    float profile;
    float3 color;
    if (code < 1.5)
    {
        const float widthPx = (code < 0.5 ? style0.x : style0.y) * scale;
        profile = SOLNL_LineProfile(interp0.x, widthPx, glowScale, scale, glow0, glow1);
        color = ringColor;
    }
    else if (code < 3.5)
    {
        const float dotPx = max(interp1.w, style0.z * scale);
        const float halfPx = SOLNL_RibbonHalfExtentPx(dotPx, scale, style1.z, glow0.x);
        profile = SOLNL_LineProfile(length(interp0.xy) * halfPx, dotPx, glowScale, scale, glow0, glow1);
        color = code < 2.5 ? dotOutColor : dotInColor;
    }
    else
    {
        profile = chevronCoverage;
        color = code < 4.5 ? chevronOutColor : chevronInColor;
    }
    if (!(profile > 0.0))
    {
        return float3(0.0, 0.0, 0.0);
    }

    // True-scale analytic occlusion by the shared spheres, then scene depth only inside the 1:1 zone
    const float3 cameraM = SOLOL_EclipticToUnreal(cameraUnreal - frame.xyz) / SOLOL_CM_PER_M;
    const float3 pointM = interp1.xyz;
    for (int index = 0; index < SOLOL_MAX_OCCLUDERS; ++index)
    {
        if (SOLOL_IsPointOccludedBySphere(cameraM, pointM, occluders[index].xyz, occluders[index].w))
        {
            return float3(0.0, 0.0, 0.0);
        }
    }
    const float trueDistanceCm = length(pointM) * SOLOL_CM_PER_M;
    const float placedCm = max(SOLOL_PlacedDistanceCm(trueDistanceCm, frame.w), 1.0);
    if (SOLOL_IsHiddenBySceneDepth(pixelDepthCm * (max(trueDistanceCm, 1.0) / placedCm), sceneDepthCm, orbitStyle2.w,
        orbitStyle2.z))
    {
        return float3(0.0, 0.0, 0.0);
    }
    return color * (alpha * style1.x * profile);
}
